{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/server/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "webpackConfigPath": "webpack.config.js",
    "tsConfigPath": "apps/server/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/server",
  "projects": {
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json",
        "webpack": true,
        "webpackConfigPath": "webpack.config.js"
      }
    },
    "server": {
      "type": "application",
      "root": "apps/server",
      "entryFile": "main",
      "sourceRoot": "apps/server/src",
      "compilerOptions": {
        "tsConfigPath": "apps/server/tsconfig.app.json"
      }
    },
    "workflow": {
      "type": "application",
      "root": "apps/workflow",
      "entryFile": "main",
      "sourceRoot": "apps/workflow/src",
      "compilerOptions": {
        "tsConfigPath": "apps/workflow/tsconfig.app.json",
        "webpack": true,
        "webpackConfigPath": "webpack.config.js"
      }
    },
    "workflow-lib": {
      "type": "library",
      "root": "libs/workflow",
      "entryFile": "index",
      "sourceRoot": "libs/workflow/src",
      "compilerOptions": {
        "tsConfigPath": "libs/workflow/tsconfig.lib.json"
      }
    },
    "workspace": {
      "type": "library",
      "root": "libs/workspace",
      "entryFile": "index",
      "sourceRoot": "libs/workspace/src",
      "compilerOptions": {
        "tsConfigPath": "libs/workspace/tsconfig.lib.json"
      }
    }
  }
}